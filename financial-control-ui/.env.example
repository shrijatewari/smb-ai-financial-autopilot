# Copy to `.env` in this folder. Vite exposes only vars prefixed with VITE_.

# API base (dev: leave unset to use Vite proxy `/api` → localhost:8000)
# VITE_API_URL=http://localhost:8000

# Production (e.g. Vercel): set VITE_API_URL in the Vercel project → Settings → Environment Variables
# to your public FastAPI origin, no trailing slash, e.g. https://your-api.railway.app
